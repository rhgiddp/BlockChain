# 서버 설정
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# 데이터베이스 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=konet_wallet
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 설정
JWT_SECRET=konet-secret-key-change-in-production-please
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 암호화 키 (32자)
ENCRYPTION_KEY=konet-wallet-encryption-key-32b

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
