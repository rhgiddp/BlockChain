# KONET 블록체인 노드 Dockerfile
# Rust 기반 블록체인 코어를 위한 멀티스테이지 빌드

# ============================================
# 빌드 스테이지
# ============================================
FROM rust:1.80-slim as builder

# 작업 디렉토리 생성
WORKDIR /app

# 시스템 의존성 설치
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# 의존성만 먼저 빌드 (캐싱 최적화)
COPY blockchain-core/Cargo.toml blockchain-core/Cargo.lock ./
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

# 실제 소스 코드 복사
COPY blockchain-core/src ./src

# 릴리스 빌드
RUN cargo build --release

# ============================================
# 런타임 스테이지 (경량화)
# ============================================
FROM debian:bookworm-slim

# 런타임 의존성
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# 작업 디렉토리
WORKDIR /app

# 빌드 결과물 복사
COPY --from=builder /app/target/release/blockchain-node /usr/local/bin/

# 포트 노출
EXPOSE 8080

# 헬스체크
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# 실행
CMD ["blockchain-node", "start", "--host", "0.0.0.0", "--port", "8080"]
